# ─────────────────────────────────────────────
# Anthropic
# ─────────────────────────────────────────────
# Your Anthropic API key from console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Model to use for all agents
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ─────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────
# Project URL from supabase.com/dashboard
SUPABASE_URL=https://your-project.supabase.co
# Anon/public key (safe for client)
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Service role key (server only, never expose)
SUPABASE_SERVICE_KEY=your_supabase_service_key_here

# ─────────────────────────────────────────────
# Pinecone
# ─────────────────────────────────────────────
# API key from app.pinecone.io
PINECONE_API_KEY=your_pinecone_api_key_here
# Index name (created by infra/pinecone/setup.py)
PINECONE_INDEX_NAME=studyai-summaries
# Cloud environment e.g. us-east-1
PINECONE_ENVIRONMENT=us-east-1

# ─────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────
# Redis connection URL
REDIS_URL=redis://redis:6379/0

# ─────────────────────────────────────────────
# Celery
# ─────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ─────────────────────────────────────────────
# App
# ─────────────────────────────────────────────
# Set to false in production
APP_DEBUG=true
# Comma-separated allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Free tier daily run limit
RATE_LIMIT_FREE_PER_DAY=10
# Pro tier daily run limit
RATE_LIMIT_PRO_PER_DAY=500
# App secret for signing tokens
APP_SECRET_KEY=your_super_secret_key_change_in_production
